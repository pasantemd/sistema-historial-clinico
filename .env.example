# Base de datos PostgreSQL
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/sistema-historial-clinico?schema=public"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REEMPLAZAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO"

# Administrador inicial (solo para desarrollo local y prisma db seed)
SEED_ADMIN_EMAIL="administrador@desarrollo.local"
SEED_ADMIN_PASSWORD="REEMPLAZAR_POR_UNA_CLAVE_LOCAL_SEGURA"

# Playwright (opcional)
# El servidor E2E usa el puerto 3100 por defecto para no interferir con npm run dev.
PLAYWRIGHT_BASE_URL="http://127.0.0.1:3100"
PLAYWRIGHT_EMAIL=""
PLAYWRIGHT_PASSWORD=""

# Clave usada al cargar el dataset QA. Use el mismo valor en PLAYWRIGHT_PASSWORD.
QA_E2E_PASSWORD=""

# Cambiar a SI únicamente contra una base QA aislada.
PLAYWRIGHT_PERMITIR_ESCRITURAS="NO"
