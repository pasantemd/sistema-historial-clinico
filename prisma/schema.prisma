  @@index([empresaId])
  @@index([departamentoId])
  @@index([fechaAtencion])
  @@index([estado])
  @@map("AtencionMedica")
}

enum EstadoRegistroDiario {
  BORRADOR
  REGISTRADO
  ANULADO
}

enum EstadoMedicamentoInventario {
  ACTIVO
  INACTIVO
}

enum UnidadMedicamentoInventario {
  UNIDADES
  TABLETAS
  CAPSULAS
  FRASCOS
  AMPOLLAS
  SOBRES
  TUBOS
  MILILITROS
  OTRO
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
  DEVOLUCION
}

model RegistroDiarioAtencion {
  id               String  @id @default(uuid()) @db.Uuid
  numeroRegistro   String  @unique
  trabajadorId     String  @db.Uuid
  atencionMedicaId String? @db.Uuid
  empresaId        String  @db.Uuid
  departamentoId   String? @db.Uuid
  profesionalId    String? @db.Uuid

  apellidosNombres String
  cedula           String
  fechaNacimiento  DateTime? @db.Date
  diaAtencion      DateTime  @db.Date

  atencionMorbilidad String
  medicacion         String?
  procedimiento      String?
  firmaConfirmada    Boolean @default(false)
  observaciones      String?

  empresaNombreHistorico      String
  empresaRucHistorico         String?
  departamentoNombreHistorico String?
  profesionalNombreHistorico  String?

  estado          EstadoRegistroDiario @default(BORRADOR)
  creadoPorId     String               @db.Uuid
  creadoEn        DateTime             @default(now())
  actualizadoEn   DateTime             @updatedAt
  anuladoEn       DateTime?
  motivoAnulacion String?

  trabajador         Trabajador                  @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)
  empresa            Empresa                     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  departamento       Departamento?               @relation(fields: [departamentoId], references: [id], onDelete: Restrict)
  profesional        Usuario?                    @relation("RegistroDiarioProfesional", fields: [profesionalId], references: [id], onDelete: SetNull)
  atencionMedica     AtencionMedica?             @relation(fields: [atencionMedicaId], references: [id], onDelete: SetNull)
  creadoPor          Usuario                     @relation("RegistroDiarioCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  evaluaciones       EvaluacionMedica[]
  fichas             FichaOcupacional[]
  recetas            RecetaMedica[]
  documentosClinicos DocumentoClinico[]
  medicamentos       RegistroDiarioMedicamento[]

  @@index([trabajadorId])
  @@index([diaAtencion])
  @@index([empresaId])
  @@index([cedula])
  @@index([estado])
  @@map("registros_diarios_atencion")
}

model MedicamentoInventario {
  id                      String                      @id @default(uuid()) @db.Uuid
  nombre                  String
  cantidadDisponible      Decimal                     @default(0) @db.Decimal(12, 2)
  unidad                  UnidadMedicamentoInventario
  fechaCaducidad          DateTime?                   @db.Date
  estado                  EstadoMedicamentoInventario @default(ACTIVO)
  observaciones           String?
  creadoPorUsuarioId      String?                     @db.Uuid
  actualizadoPorUsuarioId String?                     @db.Uuid
  creadoEn                DateTime                    @default(now())
  actualizadoEn           DateTime                    @updatedAt

  creadoPorUsuario      Usuario?                    @relation("MedicamentoInventarioCreadoPor", fields: [creadoPorUsuarioId], references: [id], onDelete: SetNull)
  actualizadoPorUsuario Usuario?                    @relation("MedicamentoInventarioActualizadoPor", fields: [actualizadoPorUsuarioId], references: [id], onDelete: SetNull)
  movimientos           MovimientoInventario[]
  entregasRegistro      RegistroDiarioMedicamento[]

  @@index([nombre])
  @@index([estado])
  @@map("medicamentos_inventario")
}

model MovimientoInventario {
  id                      String                   @id @default(uuid()) @db.Uuid
  medicamentoInventarioId String                   @db.Uuid
  tipoMovimiento          TipoMovimientoInventario
  cantidad                Decimal                  @db.Decimal(12, 2)
  cantidadAnterior        Decimal                  @db.Decimal(12, 2)
  cantidadPosterior       Decimal                  @db.Decimal(12, 2)
  motivo                  String
  referenciaTipo          String?
  referenciaId            String?
  usuarioId               String                   @db.Uuid
  creadoEn                DateTime                 @default(now())

  medicamentoInventario MedicamentoInventario       @relation(fields: [medicamentoInventarioId], references: [id], onDelete: Restrict)
  usuario               Usuario                     @relation("MovimientoInventarioUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  entregasRegistro      RegistroDiarioMedicamento[]

  @@index([medicamentoInventarioId])
  @@index([tipoMovimiento])
  @@index([referenciaTipo, referenciaId])
  @@index([usuarioId])
  @@map("movimientos_inventario")
}

model RegistroDiarioMedicamento {
  id                      String   @id @default(uuid()) @db.Uuid
  registroDiarioId        String   @db.Uuid
  medicamentoInventarioId String   @db.Uuid
  nombreSnapshot          String
  unidadSnapshot          String
  cantidadEntregada       Decimal  @db.Decimal(12, 2)
  movimientoInventarioId  String?  @unique @db.Uuid
  creadoEn                DateTime @default(now())

  registroDiario        RegistroDiarioAtencion @relation(fields: [registroDiarioId], references: [id], onDelete: Restrict)
  medicamentoInventario MedicamentoInventario  @relation(fields: [medicamentoInventarioId], references: [id], onDelete: Restrict)
  movimientoInventario  MovimientoInventario?  @relation(fields: [movimientoInventarioId], references: [id], onDelete: SetNull)

  @@unique([registroDiarioId, medicamentoInventarioId])
  @@index([registroDiarioId])
  @@index([medicamentoInventarioId])
  @@map("registro_diario_medicamentos")
}

