model RecetaMedica {
  id                               String       @id @default(uuid()) @db.Uuid
  atencionMedicaId                 String?      @db.Uuid
  evaluacionId                     String?      @unique @map("evaluacionId") @db.Uuid
  consultaMedicaId                 String?      @db.Uuid
  registroDiarioId                 String?      @db.Uuid
  fichaOcupacionalId               String?      @db.Uuid
  documentoClinicoId               String?      @db.Uuid
  trabajadorId                     String       @db.Uuid
  empresaId                        String       @db.Uuid
  departamentoId                   String?      @db.Uuid
  asignacionLaboralId              String?      @db.Uuid
  profesionalId                    String       @db.Uuid
  numeroReceta                     String
  fechaEmision                     DateTime     @map("fecha") @db.Date
  estado                           EstadoReceta @default(BORRADOR)
  indicacionesGenerales            String?      @map("indicaciones")
  recomendaciones                  String?
  observaciones                    String?
  trabajadorNombreHistorico        String
  trabajadorDocumentoHistorico     String
  empresaNombreHistorico           String
  empresaRucHistorico              String
  empresaDireccionHistorica        String?
  empresaTelefonoHistorico         String?
  departamentoNombreHistorico      String?
  trabajadorSexoHistorico          String?
  trabajadorNacimientoHistorico    DateTime?    @db.Date
  profesionalNombreHistorico       String
  profesionalCodigoHistorico       String?
  profesionalEspecialidadHistorica String?
  diagnosticosHistoricos           Json?
  alergiaConfirmada                Boolean      @default(false)
  justificacionAlergia             String?
  alergiaConfirmadaPorId           String?      @db.Uuid
  alergiaConfirmadaEn              DateTime?
  creadoPorId                      String?      @map("usuarioId") @db.Uuid
  creadoEn                         DateTime     @default(now())
  actualizadoEn                    DateTime     @updatedAt
  anuladaEn                        DateTime?    @db.Date
  emitidaEn                        DateTime?
  motivoAnulacion                  String?

  atencionMedica       AtencionMedica?         @relation(fields: [atencionMedicaId], references: [id], onDelete: SetNull)
  evaluacion           EvaluacionMedica?       @relation(fields: [evaluacionId], references: [id], onDelete: Restrict)
  registroDiario       RegistroDiarioAtencion? @relation(fields: [registroDiarioId], references: [id], onDelete: Restrict)
  fichaOcupacional     FichaOcupacional?       @relation(fields: [fichaOcupacionalId], references: [id], onDelete: Restrict)
  documentoClinico     DocumentoClinico?       @relation(fields: [documentoClinicoId], references: [id], onDelete: Restrict)
  trabajador           Trabajador              @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)
  empresa              Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  departamento         Departamento?           @relation(fields: [departamentoId], references: [id], onDelete: Restrict)
  asignacionLaboral    AsignacionLaboral?      @relation(fields: [asignacionLaboralId], references: [id], onDelete: Restrict)
  profesional          Usuario                 @relation("RecetaResponsable", fields: [profesionalId], references: [id], onDelete: Restrict)
  creadoPor            Usuario?                @relation("RecetaCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  alergiaConfirmadaPor Usuario?                @relation("RecetaAlergiaConfirmadaPor", fields: [alergiaConfirmadaPorId], references: [id], onDelete: SetNull)
  medicamentos         RecetaMedicamento[]

  @@unique([numeroReceta])
  @@index([atencionMedicaId])
  @@index([evaluacionId])
  @@index([registroDiarioId])
  @@index([fichaOcupacionalId])
  @@index([documentoClinicoId])
  @@index([asignacionLaboralId])
  @@index([trabajadorId])
  @@index([empresaId])
  @@index([profesionalId])
  @@index([alergiaConfirmadaPorId])
  @@index([fechaEmision])
  @@index([estado])
  @@map("Receta")
}

model RecetaMedicamento {
  id                         String  @id @default(uuid()) @db.Uuid
  recetaId                   String  @db.Uuid
