generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoRegistro {
  ACTIVO
  INACTIVO
}

enum EstadoTrabajador {
  ACTIVO
  INACTIVO
  SUSPENDIDO
  RETIRADO
}

enum TipoDocumento {
  CEDULA
  PASAPORTE
  RUC
  OTRO
}

enum Sexo {
  MASCULINO
  FEMENINO
  OTRO
  NO_ESPECIFICADO
}

enum ResultadoAuditoria {
  EXITOSO
  FALLIDO
}

enum EstadoVinculoLaboral {
  ACTIVO
  SUSPENDIDO
  FINALIZADO
}

enum EstadoEvaluacionMedica {
  BORRADOR
  FINALIZADA
  ANULADA
}

enum TipoAlergia {
  MEDICAMENTO
  ALIMENTO
  AMBIENTAL
  OTRA
}

enum SeveridadAlergia {
  LEVE
  MODERADA
  GRAVE
}

enum EstadoAtencionMedica {
  ABIERTA
  FINALIZADA
  ANULADA
}

enum EstadoReceta {
  BORRADOR
  EMITIDA
  ANULADA
}

enum EstadoCitaMedica {
  PROGRAMADA
  CONFIRMADA
  ATENDIDA
  CANCELADA
  NO_ASISTIO
}

enum EstadoDocumentoClinico {
  BORRADOR
  FINALIZADO
  ANULADO
}

enum TipoDiagnosticoClinico {
  PRESUNTIVO
  DEFINITIVO
}

model Usuario {
  id                String         @id @default(uuid()) @db.Uuid
  nombres           String
  apellidos         String
  cedula            String?        @unique
  codigoProfesional String?
  especialidad      String?
  correo            String         @unique
  claveHash         String
  estado            EstadoRegistro @default(ACTIVO)
  ultimoAccesoEn    DateTime?
  creadoEn          DateTime       @default(now())
  actualizadoEn     DateTime       @updatedAt

  roles                          UsuarioRol[]
  auditorias                     Auditoria[]
  trabajadoresCreados            Trabajador[]             @relation("TrabajadorCreadoPor")
  trabajadoresActualizados       Trabajador[]             @relation("TrabajadorActualizadoPor")
  fichasResponsable              FichaOcupacional[]       @relation("FichaResponsable")
  fichasCreadas                  FichaOcupacional[]       @relation("FichaCreadoPor")
  fichasActualizadas             FichaOcupacional[]       @relation("FichaActualizadoPor")
  evaluacionesResponsable        EvaluacionMedica[]       @relation("EvaluacionResponsable")
  evaluacionesCreadas            EvaluacionMedica[]       @relation("EvaluacionCreadoPor")
  evaluacionesActualizadas       EvaluacionMedica[]       @relation("EvaluacionActualizadoPor")
  recetasResponsable             RecetaMedica[]           @relation("RecetaResponsable")
  recetasCreadas                 RecetaMedica[]           @relation("RecetaCreadoPor")
  recetasAlergiaConfirmada       RecetaMedica[]           @relation("RecetaAlergiaConfirmadaPor")
  atencionesResponsable          AtencionMedica[]         @relation("AtencionResponsable")
  atencionesCreadas              AtencionMedica[]         @relation("AtencionCreadoPor")
  registrosDiariosProfesional    RegistroDiarioAtencion[] @relation("RegistroDiarioProfesional")
  registrosDiariosCreados        RegistroDiarioAtencion[] @relation("RegistroDiarioCreadoPor")
  documentosClinicosProfesional  DocumentoClinico[]       @relation("DocumentoClinicoProfesional")
  documentosClinicosCreados      DocumentoClinico[]       @relation("DocumentoClinicoCreadoPor")
  documentosClinicosActualizados DocumentoClinico[]       @relation("DocumentoClinicoActualizadoPor")
  citasProfesional               CitaMedica[]             @relation("CitaProfesional")
  citasCreadas                   CitaMedica[]             @relation("CitaCreadoPor")
  medicamentosInventarioCreados  MedicamentoInventario[]  @relation("MedicamentoInventarioCreadoPor")
  medicamentosInventarioEditados MedicamentoInventario[]  @relation("MedicamentoInventarioActualizadoPor")
  movimientosInventario          MovimientoInventario[]   @relation("MovimientoInventarioUsuario")
  empresasAutorizadas            UsuarioEmpresa[]
}

model Rol {
  id            String         @id @default(uuid()) @db.Uuid
  nombre        String         @unique
  descripcion   String?
  estado        EstadoRegistro @default(ACTIVO)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  usuarios UsuarioRol[]
  permisos RolPermiso[]
}

model Permiso {
  id            String         @id @default(uuid()) @db.Uuid
  codigo        String         @unique
  nombre        String
  descripcion   String?
  modulo        String
  estado        EstadoRegistro @default(ACTIVO)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  roles RolPermiso[]
}

model UsuarioRol {
  usuarioId  String   @db.Uuid
  rolId      String   @db.Uuid
  asignadoEn DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@unique([usuarioId])
}

model RolPermiso {
  rolId      String   @db.Uuid
  permisoId  String   @db.Uuid
  asignadoEn DateTime @default(now())

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
}

model Empresa {
  id                            String         @id @default(uuid()) @db.Uuid
  ruc                           String         @unique
  razonSocial                   String
  nombreComercial               String?
  actividadEconomicaCodigo      String?
  actividadEconomicaDescripcion String?
  telefono                      String?
  correo                        String?
  direccion                     String?
  estado                        EstadoRegistro @default(ACTIVO)
  creadoEn                      DateTime       @default(now())
  actualizadoEn                 DateTime       @updatedAt

  departamentos         Departamento[]
  trabajadores          Trabajador[]
  asignacionesLaborales AsignacionLaboral[]
  fichaOcupacionals     FichaOcupacional[]
  evaluacionesMedicas   EvaluacionMedica[]
  recetas               RecetaMedica[]
  atenciones            AtencionMedica[]
  registrosDiarios      RegistroDiarioAtencion[]
  documentosClinicos    DocumentoClinico[]
  citas                 CitaMedica[]
  usuariosAutorizados   UsuarioEmpresa[]

  @@index([estado])
  @@map("Empresa")
}

model UsuarioEmpresa {
  usuarioId  String   @db.Uuid
  empresaId  String   @db.Uuid
  asignadoEn DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, empresaId])
  @@index([empresaId])
  @@map("UsuarioEmpresa")
}

model Departamento {
  id            String         @id @default(uuid()) @db.Uuid
  empresaId     String         @db.Uuid
  nombre        String
  descripcion   String?
  estado        EstadoRegistro @default(ACTIVO)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  empresa               Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  trabajadores          Trabajador[]
  asignacionesLaborales AsignacionLaboral[]
  fichaOcupacionals     FichaOcupacional[]
  evaluacionesMedicas   EvaluacionMedica[]
  recetas               RecetaMedica[]
  atenciones            AtencionMedica[]
  registrosDiarios      RegistroDiarioAtencion[]
  documentosClinicos    DocumentoClinico[]
  citas                 CitaMedica[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@index([estado])
  @@map("Departamento")
}

model Trabajador {
  id               String           @id @default(uuid()) @db.Uuid
  empresaId        String           @db.Uuid
  departamentoId   String           @db.Uuid
  tipoDocumento    TipoDocumento    @default(CEDULA)
  numeroDocumento  String
  nombres          String
  apellidos        String
  fechaNacimiento  DateTime?        @db.Date
  sexo             Sexo             @default(NO_ESPECIFICADO)
  telefono         String?
  correo           String?
  direccion        String?
  puestoLaboral    String?
  tipoContrato     String?
  jornadaLaboral   String?
  areaTrabajo      String?
  lugarTrabajo     String?
  estadoLaboral    EstadoTrabajador @default(ACTIVO)
  creadoPorId      String?          @db.Uuid
  actualizadoPorId String?          @db.Uuid
  creadoEn         DateTime         @default(now())
  actualizadoEn    DateTime         @updatedAt

  empresa               Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  departamento          Departamento             @relation(fields: [departamentoId], references: [id], onDelete: Restrict)
  creadoPor             Usuario?                 @relation("TrabajadorCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  actualizadoPor        Usuario?                 @relation("TrabajadorActualizadoPor", fields: [actualizadoPorId], references: [id], onDelete: SetNull)
  asignacionesLaborales AsignacionLaboral[]
  fichaOcupacionals     FichaOcupacional[]
  evaluacionesMedicas   EvaluacionMedica[]
  recetas               RecetaMedica[]
  alergias              AlergiaTrabajador[]
  atenciones            AtencionMedica[]
  registrosDiarios      RegistroDiarioAtencion[]
  documentosClinicos    DocumentoClinico[]
  citas                 CitaMedica[]

  @@unique([tipoDocumento, numeroDocumento])
  @@index([empresaId])
  @@index([departamentoId])
}

model AsignacionLaboral {
  id             String               @id @default(uuid()) @db.Uuid
  trabajadorId   String               @db.Uuid
  empresaId      String               @db.Uuid
  departamentoId String               @db.Uuid
  // Legado: la interfaz ya no solicita fecha de inicio laboral; los nuevos
  // registros se crean sin fecha (null). Se preserva el dato histórico.
  fechaInicio    DateTime?            @map("fechaIngreso") @db.Date
  fechaReingreso DateTime?            @db.Date
  fechaFin       DateTime?            @map("fechaSalida") @db.Date
  activa         Boolean              @default(true)
  estado         EstadoVinculoLaboral @default(ACTIVO)
  creadoEn       DateTime             @default(now())
  actualizadoEn  DateTime             @updatedAt

  trabajador   Trabajador         @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)
  empresa      Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  departamento Departamento       @relation(fields: [departamentoId], references: [id], onDelete: Restrict)
  fichas       FichaOcupacional[]
  evaluaciones EvaluacionMedica[]
  recetas      RecetaMedica[]
  atenciones   AtencionMedica[]

  @@index([trabajadorId])
  @@index([empresaId])
  @@index([departamentoId])
  @@index([trabajadorId, activa])
  @@map("VinculoLaboral")
}

model Auditoria {
  id              String             @id @default(uuid()) @db.Uuid
  usuarioId       String?            @db.Uuid
  accion          String
  modulo          String
  entidad         String
  entidadId       String?
  direccionIp     String?
  agenteUsuario   String?
  datosAnteriores Json?
  datosNuevos     Json?
  resultado       ResultadoAuditoria
  creadoEn        DateTime           @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([creadoEn])
  @@index([modulo, creadoEn])
  @@index([usuarioId, creadoEn])
}

model IntentoInicioSesion {
  id        String   @id @default(uuid()) @db.Uuid
  claveHash String   @db.VarChar(64)
  creadoEn  DateTime @default(now())

  @@index([claveHash, creadoEn])
  @@index([creadoEn])
}

enum TipoEvaluacionOcupacional {
  INGRESO
  PERIODICA
  REINGRESO
  RETIRO
}

enum AptitudMedicaOcupacional {
  APTO
  APTO_EN_OBSERVACION
  APTO_CON_LIMITACIONES
  NO_APTO
}

enum EstadoFichaOcupacional {
  BORRADOR
  FINALIZADA
  ANULADA
}

enum NivelCie10 {
  CATEGORIA
  SUBCATEGORIA
}

model EnfermedadCie10 {
  id                   String     @id @default(uuid()) @db.Uuid
  codigo               String     @unique @db.VarChar(10)
  descripcion          String     @db.Text
  nivel                NivelCie10
  categoriaPadreCodigo String?    @db.VarChar(10)
  activa               Boolean    @default(true)
  creadoEn             DateTime   @default(now())
  actualizadoEn        DateTime   @updatedAt

  categoriaPadre           EnfermedadCie10?              @relation("CategoriaCie10", fields: [categoriaPadreCodigo], references: [codigo], onDelete: Restrict)
  subcategorias            EnfermedadCie10[]             @relation("CategoriaCie10")
  diagnosticos             DiagnosticoFicha[]
  diagnosticosEvaluaciones DiagnosticoEvaluacion[]
  diagnosticosDocumentos   DocumentoClinicoDiagnostico[]
  sinonimos                SinonimoCie10[]

  @@index([codigo])
  @@index([descripcion])
  @@index([categoriaPadreCodigo])
  @@map("enfermedades_cie10")
}

model SinonimoCie10 {
  id           String   @id @default(uuid()) @db.Uuid
  termino      String   @db.VarChar(160)
  enfermedadId String   @db.Uuid
  creadoEn     DateTime @default(now())

  enfermedad EnfermedadCie10 @relation(fields: [enfermedadId], references: [id], onDelete: Restrict)

  @@unique([termino, enfermedadId])
  @@index([termino])
  @@index([enfermedadId])
  @@map("sinonimos_cie10")
}

model FichaOcupacional {
  id                  String                    @id @default(uuid()) @db.Uuid
  numeroFicha         String?                   @unique
  trabajadorId        String                    @db.Uuid
  empresaId           String                    @db.Uuid
  departamentoId      String                    @db.Uuid
  asignacionLaboralId String?                   @db.Uuid
  atencionMedicaId    String?                   @db.Uuid
  registroDiarioId    String?                   @db.Uuid
  usuarioId           String                    @db.Uuid
  tipoEvaluacion      TipoEvaluacionOcupacional
  estado              EstadoFichaOcupacional    @default(BORRADOR)

  empresaNombreHistorico      String?
  empresaRucHistorico         String?
  departamentoNombreHistorico String?

  institucionSistema    String?
  tipoInstitucion       String?
  ruc                   String?
  ciiu                  String?
  establecimiento       String?
  numeroHistoriaClinica String?
  numeroArchivo         String?
  primerApellido        String?
  segundoApellido       String?
  primerNombre          String?
  segundoNombre         String?
  atencionEmbarazada    Boolean   @default(false)
  atencionDiscapacidad  Boolean   @default(false)
  atencionCatastrofica  Boolean   @default(false)
  atencionLactancia     Boolean   @default(false)
  atencionAdultoMayor   Boolean   @default(false)
  sexo                  String?
  fechaNacimiento       DateTime? @db.Date
  edad                  Int?
  grupoSanguineo        String?
  lateralidad           String?

  puestoTrabajoCIUO   String?
  fechaAtencion       DateTime? @db.Date
  fechaIngresoTrabajo DateTime? @db.Date
  fechaReintegro      DateTime? @db.Date
  fechaSalida         DateTime? @db.Date
  observacionMotivo   String?

  antecedentesClinicosQuirurgicos String?
  antecedentesFamiliares          String?
  autorizaTransfusiones           String?
  tratamientoHormonal             String?
  tratamientoHormonalCual         String?
  fechaUltimaMenstruacion         DateTime? @db.Date
  gestas                          Int?
  partos                          Int?
  cesareas                        Int?
  abortos                         Int?
  planificacionFamiliarFemenina   String?
  metodoPlanificacionFemenina     String?
  examenesFemeninos               Json?
  planificacionFamiliarMasculina  String?
  metodoPlanificacionMasculina    String?
  examenesMasculinos              Json?
  consumoSustancias               Json?
  actividadFisica                 String?
  actividadFisicaCual             String?
  actividadFisicaTiempo           String?
  medicacionHabitual              String?
  medicacionHabitualCual          String?
  medicacionHabitualCantidad      String?
  observacionEstiloVida           String?

  noRefiereSintomatologia   Boolean @default(false)
  descripcionProblemaActual String?

  temperatura               Float?
  presionArterial           String?
  frecuenciaCardiaca        Int?
  frecuenciaRespiratoria    Int?
  saturacionOxigeno         Int?
  peso                      Float?
  talla                     Float?
  imc                       Float?
  perimetroAbdominal        Float?
  examenFisico              Json?
  observacionesExamenFisico String?

  actividadesRiesgo  Json?
  factoresRiesgo     Json?
  medidasPreventivas String?

  antecedentesLaborales     Json?
  actividadesExtralaborales Json?
  resultadosExamenes        Json?
  observacionesResultados   String?
  diagnosticosLegado        Json?   @map("diagnosticos")

  aptitudMedica        String?
  observacionesAptitud String?

  recomendaciones Json?

  retiroRealizaEvaluacion  String?
  retiroRelacionadoTrabajo String?
  retiroObservacion        String?

  profesionalNombres      String?
  profesionalCodigoMedico String?
  profesionalFirmaUrl     String?
  profesionalSelloUrl     String?

  firmaTrabajadorAcepta Boolean   @default(false)
  firmaTrabajadorFecha  DateTime? @db.Date
  firmaTrabajadorUrl    String?

  creadoPorId      String?   @db.Uuid
  actualizadoPorId String?   @db.Uuid
  finalizadoEn     DateTime?
  creadoEn         DateTime  @default(now())
  actualizadoEn    DateTime  @updatedAt

  trabajador         Trabajador              @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)
  empresa            Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  departamento       Departamento            @relation(fields: [departamentoId], references: [id], onDelete: Restrict)
  asignacionLaboral  AsignacionLaboral?      @relation(fields: [asignacionLaboralId], references: [id], onDelete: Restrict)
  atencionMedica     AtencionMedica?         @relation(fields: [atencionMedicaId], references: [id], onDelete: SetNull)
  registroDiario     RegistroDiarioAtencion? @relation(fields: [registroDiarioId], references: [id], onDelete: Restrict)
  usuario            Usuario                 @relation("FichaResponsable", fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoPor          Usuario?                @relation("FichaCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  actualizadoPor     Usuario?                @relation("FichaActualizadoPor", fields: [actualizadoPorId], references: [id], onDelete: SetNull)
  diagnosticos       DiagnosticoFicha[]
  documentosClinicos DocumentoClinico[]
  recetas            RecetaMedica[]

  @@index([trabajadorId])
  @@index([empresaId])
  @@index([departamentoId])
  @@index([asignacionLaboralId])
  @@index([atencionMedicaId])
  @@index([registroDiarioId])
  @@index([usuarioId])
  @@index([tipoEvaluacion])
  @@index([estado])
  @@map("FichaOcupacional")
}

model AlergiaTrabajador {
  id            String           @id @default(uuid()) @db.Uuid
  trabajadorId  String           @db.Uuid
  tipo          TipoAlergia
  sustancia     String
  descripcion   String?
  severidad     SeveridadAlergia
  activa        Boolean          @default(true)
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt

  trabajador Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)

  @@index([trabajadorId, activa])
  @@index([tipo, sustancia])
}

model EvaluacionMedica {
  id                            String                 @id @default(uuid()) @db.Uuid
  numeroEvaluacion              String?                @unique
  trabajadorId                  String                 @db.Uuid
  empresaId                     String                 @db.Uuid
  departamentoId                String                 @db.Uuid
  asignacionLaboralId           String                 @db.Uuid
  atencionMedicaId              String?                @db.Uuid
  registroDiarioId              String?                @db.Uuid
  usuarioId                     String                 @db.Uuid
  estado                        EstadoEvaluacionMedica @default(BORRADOR)
  fechaAtencion                 DateTime?              @db.Date
  profesionalNombreHistorico    String?
  empresaNombreHistorico        String
  empresaRucHistorico           String
  departamentoNombreHistorico   String
  trabajadorNombreHistorico     String
  trabajadorDocumentoHistorico  String
  trabajadorSexoHistorico       String?
  trabajadorNacimientoHistorico DateTime?              @db.Date
  motivoConsulta                String?
  morbilidad                    String?                @db.VarChar(160)
  sintomas                      String?
  tiempoEvolucion               String?
  observacionesMotivo           String?
  temperatura                   Float?
  presionArterial               String?
  frecuenciaCardiaca            Int?
  frecuenciaRespiratoria        Int?
  saturacionOxigeno             Int?
  peso                          Float?
  talla                         Float?
  antecedentesRelevantes        String?
  examenFisico                  String?
  observacionesClinicas         String?
  observacionesDiagnostico      String?
  indicaciones                  String?
  recomendaciones               String?
  reposoDias                    Int?
  seguimiento                   String?
  proximaConsulta               DateTime?              @db.Date
  finalizadoEn                  DateTime?
  anuladaEn                     DateTime?
  motivoAnulacion               String?
  creadoPorId                   String?                @db.Uuid
  actualizadoPorId              String?                @db.Uuid
  creadoEn                      DateTime               @default(now())
  actualizadoEn                 DateTime               @updatedAt

  trabajador         Trabajador              @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)
  empresa            Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  departamento       Departamento            @relation(fields: [departamentoId], references: [id], onDelete: Restrict)
  asignacionLaboral  AsignacionLaboral       @relation(fields: [asignacionLaboralId], references: [id], onDelete: Restrict)
  atencionMedica     AtencionMedica?         @relation(fields: [atencionMedicaId], references: [id], onDelete: SetNull)
  registroDiario     RegistroDiarioAtencion? @relation(fields: [registroDiarioId], references: [id], onDelete: Restrict)
  usuario            Usuario                 @relation("EvaluacionResponsable", fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoPor          Usuario?                @relation("EvaluacionCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  actualizadoPor     Usuario?                @relation("EvaluacionActualizadoPor", fields: [actualizadoPorId], references: [id], onDelete: SetNull)
  diagnosticos       DiagnosticoEvaluacion[]
  medicamentos       MedicamentoEvaluacion[]
  receta             RecetaMedica?
  documentosClinicos DocumentoClinico[]

  @@index([trabajadorId, estado])
  @@index([empresaId])
  @@index([departamentoId])
  @@index([asignacionLaboralId])
  @@index([atencionMedicaId])
  @@index([registroDiarioId])
  @@index([usuarioId])
  @@index([fechaAtencion])
}

model DiagnosticoEvaluacion {
  id           String   @id @default(uuid()) @db.Uuid
  evaluacionId String   @db.Uuid
  enfermedadId String   @db.Uuid
  pre          Boolean  @default(false)
  def          Boolean  @default(false)
  creadoEn     DateTime @default(now())

  evaluacion EvaluacionMedica @relation(fields: [evaluacionId], references: [id], onDelete: Restrict)
  enfermedad EnfermedadCie10  @relation(fields: [enfermedadId], references: [id], onDelete: Restrict)

  @@unique([evaluacionId, enfermedadId])
  @@index([enfermedadId])
}

model Medicamento {
  id              String   @id @default(uuid()) @db.Uuid
  nombreGenerico  String
  nombreComercial String?
  presentacion    String
  activo          Boolean  @default(true)
